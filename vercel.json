{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|tesseract/|guide\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/tesseract/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/ocr.js": {
      "maxDuration": 60
    },
    "api/quota.js": {
      "maxDuration": 10
    },
    "api/vault.js": {
      "maxDuration": 30
    },
    "api/templates.js": {
      "maxDuration": 10
    }
  }
}
