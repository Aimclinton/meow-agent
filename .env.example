# ---- Server-only (Vercel → Settings → Environment Variables). Never prefix with VITE_. ----
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash
# GEMINI_DETAILED_MODEL=gemini-3-flash-preview
# DAILY_LIMIT=500

# Supabase (optional: team login, history sync, shared quota counter)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Browser (safe to expose; baked in at build time) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
