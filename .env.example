# ---- Server-only (Vercel → Settings → Environment Variables). Never prefix these with VITE_. ----
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash
# GEMINI_DETAILED_MODEL=gemini-3-flash-preview
# DAILY_LIMIT=500

# Supabase (password sync across devices, shared templates, team quota counter)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: long random string used to hash passwords for sync (defaults to the service key)
# VAULT_SECRET=

# ---- Browser (public by design) ----
# Web3Forms access key for the "ข้าต้องการสิ่งนี้เพิ่ม" button
VITE_WEB3FORMS_KEY=
